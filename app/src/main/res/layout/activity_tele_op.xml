<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activityTeleOp">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:divider="@drawable/vertical_padding_small"
            android:showDividers="middle"
            android:paddingTop="20dp"
            android:paddingHorizontal="20dp"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/header3"
                android:textSize="24sp"
                android:textColor="@color/black"
                android:gravity="center"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:divider="@drawable/vertical_padding_small"
                android:showDividers="middle|end">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textColor="@color/black"
                    android:text="@string/classified_artifacts"/>

                <!-- Attempted L1 and L2-->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:divider="@drawable/horizontal_padding_big"
                    android:showDividers="middle">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintWidth_percent="0.5"
                        android:divider="@drawable/horizontal_padding_small"
                        android:showDividers="middle">

                        <Button
                            android:id="@+id/down_count_button_ca"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:insetTop="2dp"
                            android:insetBottom="2dp"
                            android:text="@string/counter_down"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/attempted"
                            android:textColor="@color/black"/>
                        <EditText
                            android:id="@+id/edit_text_ca"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="username"
                            android:hint="@string/number_tried"
                            android:inputType="number"
                            android:minWidth="48dp"
                            android:minHeight="48dp" />
                        <Button
                            android:id="@+id/up_count_button_ca"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:insetTop="2dp"
                            android:insetBottom="2dp"
                            android:text="@string/counter_up"
                            />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintWidth_percent="0.5"
                        android:divider="@drawable/horizontal_padding_small"
                        android:showDividers="middle">
                        <Button
                            android:id="@+id/down_count_button_cs"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:insetTop="2dp"
                            android:insetBottom="2dp"
                            android:text="@string/counter_down"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/scored"
                            android:textColor="@color/black"/>
                        <EditText
                            android:id="@+id/edit_text_cs"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="username"
                            android:hint="@string/number_tried"
                            android:inputType="number"
                            android:minWidth="48dp"
                            android:minHeight="48dp" />
                        <Button
                            android:id="@+id/up_count_button_cs"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:insetTop="2dp"
                            android:insetBottom="2dp"
                            android:text="@string/counter_up"

                            />
                    </LinearLayout>
                </LinearLayout>




                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/black"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textColor="@color/black"
                    android:text="@string/overflowed_artifacts"/>

                <!-- Scored L1 and L2 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:divider="@drawable/horizontal_padding_big"
                    android:showDividers="middle">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintWidth_percent="0.5"
                        android:divider="@drawable/horizontal_padding_small"
                        android:showDividers="middle">
                        <Button
                            android:id="@+id/down_count_button_ao"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:insetTop="2dp"
                            android:insetBottom="2dp"
                            android:text="@string/counter_down"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/attempted"
                            android:textColor="@color/black"/>
                        <EditText
                            android:id="@+id/edit_text_ao"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="username"
                            android:hint="@string/number_tried"
                            android:inputType="number"
                            android:minWidth="48dp"
                            android:minHeight="48dp" />
                        <Button
                            android:id="@+id/up_count_button_ao"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:insetTop="2dp"
                            android:insetBottom="2dp"
                            android:text="@string/counter_up"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintWidth_percent="0.5"
                        android:divider="@drawable/horizontal_padding_small"
                        android:showDividers="middle">
                        <Button
                            android:id="@+id/down_count_button_so"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:insetTop="2dp"
                            android:insetBottom="2dp"
                            android:text="@string/counter_down"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/scored"
                            android:textColor="@color/black"/>
                        <EditText
                            android:id="@+id/edit_text_so"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="username"
                            android:hint="@string/number_tried"
                            android:inputType="number"
                            android:minWidth="48dp"
                            android:minHeight="48dp" />
                        <Button
                            android:id="@+id/up_count_button_so"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:insetTop="2dp"
                            android:insetBottom="2dp"
                            android:text="@string/counter_up" />
                    </LinearLayout>
                </LinearLayout>


            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/black"
                />

            <!--        algae process attempted -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="@color/black"
                android:text="@string/depot_artifacts"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:divider="@drawable/horizontal_padding_big"
                android:showDividers="middle">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintWidth_percent="0.5"
                    android:divider="@drawable/horizontal_padding_small"
                    android:showDividers="middle">
                    <Button
                        android:id="@+id/down_count_button_daa"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:insetTop="2dp"
                        android:insetBottom="2dp"
                        android:text="@string/counter_down"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/attempted"
                        android:textColor="@color/black"/>
                    <EditText
                        android:id="@+id/edit_text_daa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="username"
                        android:hint="@string/number_tried"
                        android:inputType="number"
                        android:minWidth="48dp"
                        android:minHeight="48dp" />
                    <Button
                        android:id="@+id/up_count_button_daa"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:insetTop="2dp"
                        android:insetBottom="2dp"
                        android:text="@string/counter_up"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintWidth_percent="0.5"
                    android:divider="@drawable/horizontal_padding_small"
                    android:showDividers="middle">
                    <Button
                        android:id="@+id/down_count_button_das"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:insetTop="2dp"
                        android:insetBottom="2dp"
                        android:text="@string/counter_down"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scored"
                        android:textColor="@color/black"/>
                    <EditText
                        android:id="@+id/edit_text_das"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="username"
                        android:hint="@string/number_tried"
                        android:inputType="number"
                        android:minWidth="48dp"
                        android:minHeight="48dp" />
                    <Button
                        android:id="@+id/up_count_button_das"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:insetTop="2dp"
                        android:insetBottom="2dp"
                        android:text="@string/counter_up" />
                </LinearLayout>
            </LinearLayout>






<!--algae process scored -->



<!--            algae barge attempted -->


<!--            algae barge scored -->


<!--            end game break -->

<!--            hang shallow/deep/park -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/endgame_action"
                    android:textColor="@color/black"
                    android:textSize="24sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <RadioGroup
                    android:id="@+id/endgame_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:showDividers="middle" >

                    <RadioButton
                        android:id="@+id/did_not_park"
                        android:layout_width="110dp"
                        android:layout_height="match_parent"
                        android:text="@string/no_park"
                        android:textSize="22sp" />
                    <RadioButton
                        android:id="@+id/partial_solo"
                        android:layout_width="85dp"
                        android:layout_height="match_parent"
                        android:text="@string/partial_solo"
                        android:textSize="22sp" />
                    <RadioButton
                        android:id="@+id/partial_duo"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:textSize="22sp"
                        android:text="@string/partial_duo"/>
                    <RadioButton
                        android:id="@+id/full_above"
                        android:layout_width="82dp"
                        android:layout_height="match_parent"
                        android:text="@string/full_above"
                        android:textSize="22sp" />
                    <RadioButton
                        android:id="@+id/full_below"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:textSize="22sp"
                        android:text="@string/full_below"/>
                    <RadioButton
                        android:id="@+id/full_solo"
                        android:layout_width="110dp"
                         android:layout_height="match_parent"
                         android:text="@string/full_solo"
                        android:textSize="22sp" />
                </RadioGroup>
            </LinearLayout>

<!--            if hang time (0s 10s 15s 20s 25s)-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/endgame_time"
                    android:textColor="@color/black"
                    android:textSize="24sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <RadioGroup
                    android:id="@+id/endgame_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:divider="@drawable/horizontal_padding_small"
                    android:showDividers="middle" >

                    <RadioButton
                        android:id="@+id/twenty_five"
                        android:layout_height="match_parent"
                        android:layout_width="wrap_content"
                        android:text="@string/twenty_five"
                        android:textSize="22sp" />
                    <RadioButton
                        android:id="@+id/twenty"
                        android:layout_height="match_parent"
                        android:layout_width="wrap_content"
                        android:text="@string/twenty"
                        android:textSize="22sp"
                        />
                    <RadioButton
                        android:id="@+id/fifteen"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:textSize="22sp"
                        android:text="@string/fifteen"/>
                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:id="@+id/ten"
                        android:textSize="22sp"
                        android:text="@string/ten"/>
                    <RadioButton
                        android:id="@+id/five"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:textSize="22sp"
                        android:text="@string/five"/>
                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:id="@+id/zero"
                        android:textSize="22sp"
                        android:text="@string/number_tried"/>
                </RadioGroup>
            </LinearLayout>


<!--            what pieces could they pick up -->

<!--            button save and next -->

            <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:divider="@drawable/horizontal_padding_big"
            android:showDividers="middle"
            android:gravity="end">
        <Button
            android:id="@+id/back_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:text="@string/button_back"/>
        <Button
            android:id="@+id/save_button"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:textSize="14sp"
            android:text="@string/button_next"/>
        </LinearLayout>
            <View
                android:layout_width="0dp"
                android:layout_height="80dp"/>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>